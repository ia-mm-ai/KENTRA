/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; media-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Link: </machine/SURFACE.json>; rel="describedby"; type="application/json"
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/forms/*
  Cache-Control: public, max-age=31536000, immutable

/machine/*
  Cache-Control: public, max-age=3600, must-revalidate

/predecessor/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex, nofollow, noarchive
